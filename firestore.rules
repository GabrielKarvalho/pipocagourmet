// ATENÇÃO: se o seu projeto Firebase já tem outros apps, NÃO apague as regras que existem.
// Copie só o bloco "match /pipoca_alunos/{uid}" e cole DENTRO de
//   match /databases/{database}/documents { ... }
// junto das regras que já estão lá.
//
// Se o projeto for novo (sem regras), use o arquivo inteiro abaixo.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção do app Pipoca Gourmet: cada aluno lê e grava só o próprio documento.
    match /pipoca_alunos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','since','done','seen','chk','updatedAt'])
        && request.resource.data.done is list
        && request.resource.data.done.size() <= 200;
      allow delete: if false;
    }
  }
}
